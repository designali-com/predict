{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "env": [
        "NEXT_PUBLIC_APP_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "DATABASE_URL",
        "OPENAI_API_KEY",
        "GEMINI_API_KEY",
        "GOOGLE_CALENDAR_REFRESH_TOKEN",
        "CAL_CLINIC_ADDRESS",
        "CAL_CLINIC_TIMEZONE",
        "RESEND_API_KEY",
        "EMAIL_PROVIDER",
        "EMAIL_FROM",
        "EMAIL_REPLY_TO",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_SECURE",
        "SMTP_USER",
        "SMTP_PASS",
        "WHATSAPP_PHONE_NUMBER_ID",
        "WHATSAPP_ACCESS_TOKEN",
        "WHATSAPP_OTP_TEMPLATE",
        "WHATSAPP_OTP_TEMPLATE_LANG",
        "SMS_PROVIDER",
        "SMS_OTP_TEXT",
        "MSG91_AUTH_KEY",
        "MSG91_OTP_TEMPLATE_ID",
        "MSG91_OTP_VAR",
        "TWILIO_ACCOUNT_SID",
        "TWILIO_AUTH_TOKEN",
        "TWILIO_FROM",
        "TWILIO_MESSAGING_SERVICE_SID",
        "S3_BUCKET",
        "AWS_REGION",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "OPEN_WEARABLES_API_URL",
        "NEXT_PUBLIC_OPEN_WEARABLES_API_URL",
        "DIRECT_URL",
        "DEMO_MODE",
        "NEXT_PUBLIC_DEMO_MODE",
        "NEXT_PUBLIC_DEMO_PASSWORD",
        "CRON_SECRET",
        "META_PAGE_ACCESS_TOKEN",
        "WHATSAPP_WABA_ID",
        "WHATSAPP_APP_ID",
        "NEXT_PUBLIC_CLINIC_URL",
        "NEXT_PUBLIC_OPERATIONS_URL",
        "NEXT_PUBLIC_PATIENT_URL",
        "NEXT_PUBLIC_LAB_URL",
        "REDIS_URL"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "format": {
      "dependsOn": [
        "^format"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
