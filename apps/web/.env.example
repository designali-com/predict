# ---------------------------------------------------------------------------
# apps/web — environment register
#
# Copy to .env and fill in. Every variable the app actually reads is listed
# here; anything missing from this file is a variable nothing reads.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Pooled connection (hostname contains "-pooler"). Used by the running app.
# Serverless functions must go through the pooler or they exhaust Postgres.
DATABASE_URL=

# Direct, non-pooled connection to the same database. Used ONLY by
# drizzle-kit for migrations and DDL — transaction-mode pooling breaks
# schema changes and session-level statements. Same credentials, hostname
# without the "-pooler" suffix.
DIRECT_URL=

# --- Auth ------------------------------------------------------------------
# Read implicitly by Better Auth — it does not appear anywhere in the source,
# but the app will not start without it. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The Android OAuth client (package fit.predict + the debug key's SHA-1). Not a secret;
# accepted as a Google ID-token audience for the mobile app's native sign-in.
GOOGLE_ANDROID_CLIENT_ID=

# --- App -------------------------------------------------------------------
# Canonical public origin, used for SEO metadata and OpenGraph image URLs.
# Falls back to https://predict.fit when unset, so a preview deployment will
# silently advertise production URLs unless this is set per environment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Where health coaches and receptionists are sent when they sign in here —
# they work in the operations console, not this app. Also the target of the
# /health-coach redirect kept for old bookmarks.
NEXT_PUBLIC_OPERATIONS_URL=http://localhost:3001

# --- AI --------------------------------------------------------------------
# The assistant model is chosen at runtime from ai_assistant_config; whichever
# provider that row names must have its key present here.
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- File storage (S3) -----------------------------------------------------
# Reports, profile photos and the WhatsApp media library. Same bucket for
# every app. Reports go under private/ (opened by signed link); photos and
# media under public/ (the bucket policy makes only public/* readable).
S3_BUCKET=predict.fit-643620726493-ap-south-1-an
AWS_REGION=ap-south-1
# Only on a laptop. On EC2 leave these out: the instance role supplies them.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Email ------------------------------------------------------------------
# Every email this app sends — login codes and verification links for patients — goes through one mailer
# (packages/communication/src/mailer.ts). SMTP is used when SMTP_HOST is set,
# otherwise Resend when RESEND_API_KEY is. Check the whole setup, DNS
# included, with:
#   pnpm --filter @workspace/communication mail:test you@example.com
#
# Must be an address the SMTP account is allowed to send as — the mailbox
# itself or an alias of it — or the server rejects the message.
EMAIL_FROM="Predict <care@yourdomain.in>"
# Where replies go, when that should not be EMAIL_FROM. Optional.
EMAIL_REPLY_TO=

#   Zoho (India DC)    smtppro.zoho.in                      465  SMTP_SECURE=true
#   Google Workspace   smtp.gmail.com                       465  SMTP_SECURE=true
#   Titan / Hostinger  smtp.titan.email                     465  SMTP_SECURE=true
#   Amazon SES Mumbai  email-smtp.ap-south-1.amazonaws.com  587  SMTP_SECURE=false
# Never port 25: AWS blocks it outbound by default.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# An app-specific password generated in the mail provider's security
# settings — not the mailbox's normal login password.
SMTP_PASS=

# Used only when SMTP_HOST is empty.
RESEND_API_KEY=
# Force one transport when both are configured: smtp | resend
EMAIL_PROVIDER=

# --- Scheduling -------------------------------------------------------------
# Slots come from each doctor's own hours. A virtual visit's Meet link is
# created on Google Calendar (see the clinic app). Confirmation mail uses
# EMAIL_FROM above.
CAL_CLINIC_TIMEZONE=Asia/Kolkata
CAL_CLINIC_ADDRESS=

# --- Wearables -------------------------------------------------------------
OPEN_WEARABLES_API_URL=

# Where doctors, nutritionists and admins are sent when they sign in here —
# they work in the clinic panel, not this app.
NEXT_PUBLIC_CLINIC_URL=http://localhost:3002

# --- Mobile OTP sign-in ------------------------------------------------------
# Codes go on WhatsApp first (3 tries), then SMS if the patient asks — see
# packages/db/src/otp-policy.ts for the limits.
#
# The same WhatsApp number the automation app uses. Needed here now because
# this app sends the sign-in codes itself.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# The name of an approved AUTHENTICATION-category template with a copy-code
# button. Left empty, every WhatsApp attempt fails at once and the SMS option
# opens straight away — which is also the easiest way to test the fallback.
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_LANG=en_US

# msg91 | twilio | console. console prints the code to the server log and
# refuses to run in production.
SMS_PROVIDER=
# MSG91 — sends through a Flow template tied to your DLT-registered template.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# The variable name used in that MSG91 template, if it is not "otp".
MSG91_OTP_VAR=otp
# Twilio — TWILIO_FROM or TWILIO_MESSAGING_SERVICE_SID, not both.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Text for providers that take free text (Twilio). {code} is replaced. For
# Indian numbers it must match your DLT-registered template word for word.
SMS_OTP_TEXT="{code} is your PREDICT login code. It expires in 5 minutes. Do not share it with anyone."
