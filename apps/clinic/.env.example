# Same Postgres as the other two apps — one database, three panels.
DATABASE_URL=
# Non-pooled endpoint, for drizzle-kit migrations.
DIRECT_URL=

# This panel's own origin. Must be the exact URL the browser addresses, scheme
# included — better-auth rejects any request whose Origin isn't trusted, and a
# stale value here shows up as a login that posts and bounces straight back.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3002

# The other two panels. Absolute, because they are separate origins: a staff
# member who belongs elsewhere is redirected to one of these on sign-in.
NEXT_PUBLIC_PATIENT_URL=http://localhost:3000
NEXT_PUBLIC_OPERATIONS_URL=http://localhost:3001
# The lab section on its own host (lab.predict.fit), served by this app.
NEXT_PUBLIC_LAB_URL=

# --- File storage (S3) -----------------------------------------------------
# Reports, profile photos and the WhatsApp media library. Same bucket for
# every app. Reports go under private/ (opened by signed link); photos and
# media under public/ (the bucket policy makes only public/* readable).
S3_BUCKET=predict.fit-643620726493-ap-south-1-an
AWS_REGION=ap-south-1
# Only on a laptop. On EC2 leave these out: the instance role supplies them.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Email ------------------------------------------------------------------
# Every email this app sends — login codes, password resets and verification links — goes through one mailer
# (packages/communication/src/mailer.ts). SMTP is used when SMTP_HOST is set,
# otherwise Resend when RESEND_API_KEY is. Check the whole setup, DNS
# included, with:
#   pnpm --filter @workspace/communication mail:test you@example.com
#
# Must be an address the SMTP account is allowed to send as — the mailbox
# itself or an alias of it — or the server rejects the message.
EMAIL_FROM="Predict <care@yourdomain.in>"
# Where replies go, when that should not be EMAIL_FROM. Optional.
EMAIL_REPLY_TO=

#   Zoho (India DC)    smtppro.zoho.in                      465  SMTP_SECURE=true
#   Google Workspace   smtp.gmail.com                       465  SMTP_SECURE=true
#   Titan / Hostinger  smtp.titan.email                     465  SMTP_SECURE=true
#   Amazon SES Mumbai  email-smtp.ap-south-1.amazonaws.com  587  SMTP_SECURE=false
# Never port 25: AWS blocks it outbound by default.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# An app-specific password generated in the mail provider's security
# settings — not the mailbox's normal login password.
SMTP_PASS=

# Used only when SMTP_HOST is empty.
RESEND_API_KEY=
# Force one transport when both are configured: smtp | resend
EMAIL_PROVIDER=

# Appointment confirmation is sent from EMAIL_FROM. A virtual visit's
# Google Meet link is created on that doctor's or nutritionist's own Google
# Calendar after they connect it once from Availability. The refresh token
# below is only a fallback when that person has not connected yet.
GOOGLE_CALENDAR_REFRESH_TOKEN=

# Staff can send an approved WhatsApp template from a patient's chart. Same
# number as the operations console — only ONE app may receive the inbound
# webhook, and that stays with automation.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
