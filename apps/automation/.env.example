# Same Postgres database as apps/web — copy the value from apps/web/.env.
DATABASE_URL=

# Non-pooled endpoint, for drizzle-kit migrations. Same credentials, hostname
# without the "-pooler" suffix. Migrations must not use the pooler.
DIRECT_URL=

# The dashboard (this Next.js app) — its own login, separate from apps/web's
# session, but authenticates against the same user accounts.
#
# BETTER_AUTH_URL must be the exact origin the browser addresses, scheme
# included. On EC2 behind nginx that is https://automation.example.com, NOT
# http://localhost:3001 and not the raw instance IP — better-auth rejects any
# request whose Origin isn't a trusted origin, so a stale value here shows up
# as a login that posts and silently bounces back to the login page.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# docker compose up (in this directory) exposes Redis on 6380, bound to
# loopback. Same value on EC2 as long as the container runs on the instance
# itself; point it at the ElastiCache endpoint instead if Redis ever moves
# off-box. The worker and the Next app must agree on this — two different
# Redis instances means jobs are queued into one and consumed from neither.
REDIS_URL=redis://localhost:6380

# Meta Cloud API (WhatsApp) — same values used by the webhook server.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# WhatsApp Business Account id — needed to submit templates for approval
# (Meta Business Manager > WhatsApp Manager > API Setup). Different from the
# phone number id above. Template creation is skipped (saved as draft only)
# if this isn't set.
WHATSAPP_WABA_ID=
# Arbitrary string you also set in the Meta app's webhook config.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Other webhook URLs that should also get every WhatsApp delivery (comma separated)
WHATSAPP_WEBHOOK_FORWARD_URLS=
# Meta app id — reference only, nothing reads it; kept here so the whole
# credential set lives in one place.
WHATSAPP_APP_ID=
# Meta app secret, used to verify the X-Hub-Signature-256 header.
WHATSAPP_APP_SECRET=

# HTTP port for src/http-server.ts (the webhook receiver). Keep this port
# closed in the EC2 security group: Meta only ever reaches it through nginx
# on 443, because the Cloud API refuses to deliver to plain HTTP or to a
# self-signed certificate. The callback URL registered in the Meta app is
# https://<your-domain>/webhooks/whatsapp, proxied to this port.
PORT=3100

# --- Email ------------------------------------------------------------------
# Every email this app sends — email steps in automation flows, campaigns and staff alerts — goes through one mailer
# (packages/communication/src/mailer.ts). SMTP is used when SMTP_HOST is set,
# otherwise Resend when RESEND_API_KEY is. Check the whole setup, DNS
# included, with:
#   pnpm --filter @workspace/communication mail:test you@example.com
#
# Must be an address the SMTP account is allowed to send as — the mailbox
# itself or an alias of it — or the server rejects the message.
EMAIL_FROM="Predict <care@yourdomain.in>"
# Where replies go, when that should not be EMAIL_FROM. Optional.
EMAIL_REPLY_TO=

#   Zoho (India DC)    smtppro.zoho.in                      465  SMTP_SECURE=true
#   Google Workspace   smtp.gmail.com                       465  SMTP_SECURE=true
#   Titan / Hostinger  smtp.titan.email                     465  SMTP_SECURE=true
#   Amazon SES Mumbai  email-smtp.ap-south-1.amazonaws.com  587  SMTP_SECURE=false
# Never port 25: AWS blocks it outbound by default.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# An app-specific password generated in the mail provider's security
# settings — not the mailbox's normal login password.
SMTP_PASS=

# Used only when SMTP_HOST is empty.
RESEND_API_KEY=
# Force one transport when both are configured: smtp | resend
EMAIL_PROVIDER=

# --- File storage (S3) -----------------------------------------------------
# Reports, profile photos and the WhatsApp media library. Same bucket for
# every app. Reports go under private/ (opened by signed link); photos and
# media under public/ (the bucket policy makes only public/* readable).
S3_BUCKET=predict.fit-643620726493-ap-south-1-an
AWS_REGION=ap-south-1
# Only on a laptop. On EC2 leave these out: the instance role supplies them.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# The other two panels — absolute, because they are separate origins. Someone
# signed in here without ops.access is sent to whichever one their role holds.
NEXT_PUBLIC_CLINIC_URL=http://localhost:3002
NEXT_PUBLIC_PATIENT_URL=http://localhost:3000
