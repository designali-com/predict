{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dialog-controlled",
  "type": "registry:block",
  "description": "Controlled",
  "files": [
    {
      "path": "registry/predict/components/dialog/dialog-controlled.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport {\n  Dialog,\n  DialogContent,\n  DialogDescription,\n  DialogFooter,\n  DialogHeader,\n  DialogTitle,\n} from \"@workspace/ui/components/dialog\"\n\nexport function DialogControlled() {\n  const [open, setOpen] = React.useState(false)\n  const [saved, setSaved] = React.useState(false)\n\n  return (\n    <div className=\"flex flex-col items-center gap-3\">\n      <Button variant=\"outline\" onClick={() => setOpen(true)}>\n        Share with doctor\n      </Button>\n      {saved ? (\n        <p className=\"text-xs text-muted-foreground\">Report shared.</p>\n      ) : null}\n      <Dialog open={open} onOpenChange={setOpen}>\n        <DialogContent>\n          <DialogHeader>\n            <DialogTitle>Share report</DialogTitle>\n            <DialogDescription>\n              Your doctor gets a read-only link to the October panel.\n            </DialogDescription>\n          </DialogHeader>\n          <DialogFooter>\n            <Button variant=\"outline\" onClick={() => setOpen(false)}>\n              Cancel\n            </Button>\n            <Button\n              onClick={() => {\n                setSaved(true)\n                setOpen(false)\n              }}\n            >\n              Share\n            </Button>\n          </DialogFooter>\n        </DialogContent>\n      </Dialog>\n    </div>\n  )\n}\n",
      "type": "registry:block"
    }
  ]
}