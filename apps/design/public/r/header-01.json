{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "header-01",
  "type": "registry:block",
  "description": "A site header with a tests menu, links, and a mobile sheet.",
  "files": [
    {
      "path": "registry/predict/blocks/header-01/page.tsx",
      "content": "\"use client\"\n\nimport { MenuIcon } from \"lucide-react\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport {\n  NavigationMenu,\n  NavigationMenuContent,\n  NavigationMenuItem,\n  NavigationMenuLink,\n  NavigationMenuList,\n  NavigationMenuTrigger,\n  navigationMenuTriggerStyle,\n} from \"@workspace/ui/components/navigation-menu\"\nimport { Separator } from \"@workspace/ui/components/separator\"\nimport {\n  Sheet,\n  SheetContent,\n  SheetFooter,\n  SheetHeader,\n  SheetTitle,\n  SheetTrigger,\n} from \"@workspace/ui/components/sheet\"\nimport { Logo } from \"@workspace/ui/predict/logo\"\n\nconst tests = [\n  { title: \"Full panel\", href: \"#\", description: \"40 biomarkers across every body system.\" },\n  { title: \"Heart health\", href: \"#\", description: \"Lipids, inflammation and blood pressure.\" },\n  { title: \"Hormones\", href: \"#\", description: \"Thyroid, cortisol and sex hormones.\" },\n  { title: \"Metabolic\", href: \"#\", description: \"Glucose, insulin and HbA1c.\" },\n]\n\nconst links = [\n  { title: \"How it works\", href: \"#\" },\n  { title: \"Pricing\", href: \"#\" },\n  { title: \"Clinics\", href: \"#\" },\n]\n\nexport default function Page() {\n  return (\n    <div className=\"min-h-svh\">\n      <header className=\"sticky top-0 z-40 border-b bg-background/80 backdrop-blur\">\n        <div className=\"mx-auto flex h-16 max-w-6xl items-center gap-6 px-6\">\n          <a href=\"#\" className=\"shrink-0\">\n            <Logo role=\"img\" aria-label=\"PREDICT\" className=\"h-5 w-auto\" />\n          </a>\n\n          <NavigationMenu className=\"hidden md:flex\">\n            <NavigationMenuList>\n              <NavigationMenuItem>\n                <NavigationMenuTrigger>Tests</NavigationMenuTrigger>\n                <NavigationMenuContent>\n                  <ul className=\"grid w-[480px] grid-cols-2 gap-1\">\n                    {tests.map((test) => (\n                      <li key={test.title}>\n                        <NavigationMenuLink\n                          href={test.href}\n                          className=\"flex-col items-start gap-1\"\n                        >\n                          <span className=\"font-medium\">{test.title}</span>\n                          <span className=\"line-clamp-2 text-muted-foreground\">\n                            {test.description}\n                          </span>\n                        </NavigationMenuLink>\n                      </li>\n                    ))}\n                  </ul>\n                </NavigationMenuContent>\n              </NavigationMenuItem>\n              {links.map((link) => (\n                <NavigationMenuItem key={link.title}>\n                  <NavigationMenuLink\n                    href={link.href}\n                    className={navigationMenuTriggerStyle()}\n                  >\n                    {link.title}\n                  </NavigationMenuLink>\n                </NavigationMenuItem>\n              ))}\n            </NavigationMenuList>\n          </NavigationMenu>\n\n          <div className=\"ms-auto hidden items-center gap-2 md:flex\">\n            <Button variant=\"ghost\" size=\"sm\" render={<a href=\"#\" />}>\n              Sign in\n            </Button>\n            <Button size=\"sm\" render={<a href=\"#\" />}>\n              Book a test\n            </Button>\n          </div>\n\n          <Sheet>\n            <SheetTrigger\n              render={<Button variant=\"ghost\" size=\"icon-sm\" className=\"ms-auto md:hidden\" />}\n            >\n              <MenuIcon />\n              <span className=\"sr-only\">Open menu</span>\n            </SheetTrigger>\n            <SheetContent side=\"right\">\n              <SheetHeader>\n                <SheetTitle>\n                  <Logo role=\"img\" aria-label=\"PREDICT\" className=\"h-5 w-auto\" />\n                </SheetTitle>\n              </SheetHeader>\n              <nav className=\"flex flex-col gap-1 px-6\">\n                <p className=\"pb-1 text-muted-foreground\">Tests</p>\n                {tests.map((test) => (\n                  <a key={test.title} href={test.href} className=\"py-1.5 text-sm\">\n                    {test.title}\n                  </a>\n                ))}\n                <Separator className=\"my-3\" />\n                {links.map((link) => (\n                  <a key={link.title} href={link.href} className=\"py-1.5 text-sm\">\n                    {link.title}\n                  </a>\n                ))}\n              </nav>\n              <SheetFooter>\n                <Button render={<a href=\"#\" />}>Book a test</Button>\n                <Button variant=\"outline\" render={<a href=\"#\" />}>\n                  Sign in\n                </Button>\n              </SheetFooter>\n            </SheetContent>\n          </Sheet>\n        </div>\n      </header>\n\n      <main className=\"mx-auto flex max-w-6xl flex-col items-center gap-4 px-6 py-24 text-center\">\n        <h1 className=\"text-3xl font-medium tracking-tight\">Understand your biology</h1>\n        <p className=\"max-w-md text-sm text-muted-foreground\">\n          40 biomarkers, read against healthy ranges and explained in plain words.\n        </p>\n      </main>\n    </div>\n  )\n}\n",
      "type": "registry:page",
      "target": "app/header/page.tsx"
    }
  ],
  "meta": {
    "iframeHeight": "480px"
  },
  "categories": [
    "navigation"
  ]
}