      "path": "registry/predict/components/sheet/sheet-demo.tsx",
      "content": "\"use client\"\n\nimport { Button } from \"@workspace/ui/components/button\"\nimport { Input } from \"@workspace/ui/components/input\"\nimport {\n  Sheet,\n  SheetClose,\n  SheetContent,\n  SheetDescription,\n  SheetFooter,\n  SheetHeader,\n  SheetTitle,\n  SheetTrigger,\n} from \"@workspace/ui/components/sheet\"\n\nexport function SheetDemo() {\n  return (\n    <Sheet>\n      <SheetTrigger render={<Button variant=\"outline\" />}>Add a note</SheetTrigger>\n      <SheetContent>\n        <SheetHeader>\n          <SheetTitle>Add a note</SheetTitle>\n          <SheetDescription>\n            Notes stay with this panel and show up in your report.\n          </SheetDescription>\n        </SheetHeader>\n        <div className=\"grid gap-3 px-6\">\n          <label className=\"grid gap-1.5 text-xs font-medium\">\n            Note\n            <Input placeholder=\"Slept 5 hours before the draw\" />\n          </label>\n        </div>\n        <SheetFooter>\n          <Button size=\"sm\">Save note</Button>\n          <SheetClose render={<Button variant=\"outline\" size=\"sm\" />}>Cancel</SheetClose>\n        </SheetFooter>\n      </SheetContent>\n    </Sheet>\n  )\n}\n",
      "type": "registry:block"
    }
  ]
}