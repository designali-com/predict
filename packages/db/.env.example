# ---------------------------------------------------------------------------
# packages/db — used by drizzle-kit and the scripts/ helpers.
#
# `dotenv/config` reads from the current working directory, and drizzle-kit
# runs with cwd = packages/db — so a .env in apps/web or apps/automation is
# NOT picked up here. This package needs its own .env.
# ---------------------------------------------------------------------------

# Non-pooled endpoint. Migrations and DDL must not go through the
# transaction-mode pooler. Same credentials as DATABASE_URL, hostname without
# the "-pooler" suffix.
DIRECT_URL=

# Pooled endpoint. Only used by the scripts/ helpers that go through the app
# client; drizzle-kit prefers DIRECT_URL above.
DATABASE_URL=
